# /etc/default/promui — configuration for the promui systemd service
# (loaded by promui.service via EnvironmentFile=).
#
#   sudo cp deploy/promui.env.example /etc/default/promui
#
# Every PROMUI_* variable has the same meaning as the corresponding
# --flag of promui; see README.md. Commented-out lines fall back to
# promui's built-in defaults.

# Required: the files_sd directory on this host. Must be writable by
# the promui user (chown -R promui:promui).
PROMUI_FILES_SD_DIR=/etc/prometheus/files_sd

# Path under which Prometheus sees the files_sd directory; used in the
# suggested config snippets.
PROMUI_FILES_SD_MOUNT=/etc/prometheus/files_sd

# Base URL of the Prometheus read-only API.
PROMUI_PROMETHEUS_URL=http://127.0.0.1:9090

# Listen address of the web UI.
PROMUI_LISTEN=127.0.0.1:8080

# Optional: htpasswd file for Basic Auth (empty or unset: no auth).
#PROMUI_HTPASSWD=/etc/promui/htpasswd

# Optional: header carrying the client IP when behind a trusted proxy
# (e.g. X-Forwarded-For); used as the brute-force lockout key.
#PROMUI_PROXY_HEADER=X-Forwarded-For
